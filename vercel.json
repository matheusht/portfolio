{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Vary": "Accept, Accept-Encoding",
        "Link": "</llms.txt>; rel=\"describedby\""
      },
      "continue": true
    },
    {
      "src": "/(.*)\\.md$",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8"
      },
      "continue": true
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "text/markdown"
        }
      ],
      "dest": "/index.md"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": {
            "pre": "text/markdown"
          }
        }
      ],
      "dest": "/index.md"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": {
            "suf": "text/markdown"
          }
        }
      ],
      "dest": "/index.md"
    },
