---
import BaseLayout from "../../layouts/BaseLayout.astro";

const githubStars = await fetch("https://api.github.com/repos/matheusht/redthread")
  .then((r) => r.json())
  .then((d) => d.stargazers_count ?? 17)
  .catch(() => 17);

const roles = [
  {
    company: "Avenza Security",
    role: "Founder & AI Security Engineer",
    date: "2024 — Present",
    description: "Building a practical AI security practice for companies shipping LLM applications, agents, and AI-enabled products.",
    achievements: [
      "Built RedThread — an open-source AI red-teaming and defense-evidence engine for LLM and agentic systems",
      "Ran adversarial campaigns using PAIR, TAP, Crescendo, GS-MCTS across 4+ attack objectives",
      "Implemented JudgeAgent/G-Eval scoring with OWASP LLM and MITRE ATLAS categories",
      "Built defense synthesis pipeline: exploit trace → scoped guardrail → replay validation → promotion evidence",
      "Delivered AI red-team assessments, prompt injection testing, and agentic security reviews for multiple clients",
    ],
    link: "https://github.com/matheusht/redthread",
    linkLabel: "View RedThread",
  },
  {
    company: "Avenza Cloud",
    role: "Software Engineer II",
    date: "2022 — Present",
    description: "Building secure cloud infrastructure and backend systems for SaaS platforms operating at scale.",
    achievements: [
      "Architected backend APIs and cloud infrastructure serving 10+ clients with 99.9% availability",
      "Designed and maintained AWS/Kubernetes deployments with mTLS, RBAC, and secure data storage",
      "Built telemetry and monitoring pipelines using Elastic Stack for distributed systems observability",
      "Implemented CI/CD pipelines and secure SDLC practices across the engineering stack",
      "Protected $2.8M+ in client revenue through infrastructure reliability and security controls",
    ],
  },
  {
    company: "Marketisa",
    role: "DevSecOps / Software Engineer",
    date: "2020 — 2022",
    description: "Integrated security practices into the software development lifecycle and cloud operations.",
    achievements: [
      "Implemented secure SDLC practices including credential handling, input validation, and access controls",
      "Built and maintained cloud infrastructure with monitoring, alerting, and incident response",
      "Developed backend services and APIs with Python and JavaScript across distributed systems",
      "Established security review processes for code deployments and infrastructure changes",
    ],
  },
];
---

<BaseLayout
  title="Experience — Matheus Theodoro"
  description="AI Security Engineer, founder of Avenza Security, builder of RedThread. Experience across AI security, cloud engineering, and DevSecOps."
>
  <div class="master-grid">
    <main class="col-span-12 md:col-span-8 md:col-start-3" style="animation: settleIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards; opacity: 0;">
      {
        roles.map((role, i) => (
          <article style="margin-bottom: var(--ma-5); opacity: 0; animation: settleIn 0.4s cubic-bezier(0.25, 1, 0.5, 1) forwards; transform: translateY(8px); animation-delay: {i * 0.1}s;">
            <div style="font-family: var(--font-sans-en); color: color-mix(in oklab, var(--color-warm-gray) 65%, transparent); font-variant: small-caps; letter-spacing: 0.03em; display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-bottom: 16px; font-size: 12px; line-height: 1.4;">
              <span style="border: 2px solid var(--color-vermilion); color: var(--color-vermilion); font-family: var(--font-sans-en); text-transform: uppercase; letter-spacing: 0.08em; padding: 4px 8px; font-size: 11px; font-weight: 700;">
                {role.company}
              </span>
              <span style="color: color-mix(in oklab, var(--color-warm-gray) 65%, transparent);">{role.date}</span>
            </div>
            <h2 class="post-title">{role.role}</h2>
            <p style="color: var(--color-warm-gray); margin: 0 0 16px; font-size: 18px; line-height: 1.6;">
              {role.description}
            </p>
            <ul style="color: var(--color-warm-gray); margin: 0 0 16px; padding-left: 24px; font-size: 18px; line-height: 1.8; list-style-type: disc;">
              {role.achievements.map((a) => (
                <li style="margin-bottom: 8px; padding-left: 8px;">{a}</li>
              ))}
            </ul>
            {role.link && (
              <a class="blog-link" href={role.link} target="_blank" rel="noopener noreferrer">
                {role.linkLabel}
              </a>
            )}
          </article>
        ))
      }

      <section style="margin-bottom: var(--ma-5); padding-top: var(--ma-3); border-top: 1px solid var(--color-light-gray);">
        <h2 class="section-title" style="font-family: var(--font-sans-en);">Notable Projects</h2>

        <div style="margin-top: var(--ma-2);">
          <div style="font-family: var(--font-sans-en); color: color-mix(in oklab, var(--color-warm-gray) 65%, transparent); font-variant: small-caps; letter-spacing: 0.03em; display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-bottom: 12px; font-size: 12px; line-height: 1.4;">
            <span style="border: 2px solid var(--color-vermilion); color: var(--color-vermilion); font-family: var(--font-sans-en); text-transform: uppercase; letter-spacing: 0.08em; padding: 4px 8px; font-size: 11px; font-weight: 700;">Open Source</span>
            <span style="color: color-mix(in oklab, var(--color-warm-gray) 65%, transparent);">2025 — Present</span>
          </div>
          <h3 style="margin: 0 0 12px; font-size: 24px; font-weight: 600; color: var(--color-warm-gray);">RedThread</h3>
          <p style="color: var(--color-warm-gray); margin: 0 0 12px; font-size: 18px; line-height: 1.6;">
            CLI-first autonomous AI red-teaming and defense-evidence engine. Runs adversarial campaigns with PAIR, TAP, Crescendo, GS-MCTS. Scores traces with JudgeAgent rubrics. Synthesizes guardrails and validates through replay.
          </p>
          <a class="blog-link" href="https://github.com/matheusht/redthread" target="_blank" rel="noopener noreferrer">View on GitHub — {githubStars} ★</a>
        </div>

        <div style="margin-top: var(--ma-4);">
          <div style="font-family: var(--font-sans-en); color: color-mix(in oklab, var(--color-warm-gray) 65%, transparent); font-variant: small-caps; letter-spacing: 0.03em; display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-bottom: 12px; font-size: 12px; line-height: 1.4;">
            <span style="border: 2px solid var(--color-vermilion); color: var(--color-vermilion); font-family: var(--font-sans-en); text-transform: uppercase; letter-spacing: 0.08em; padding: 4px 8px; font-size: 11px; font-weight: 700;">Hackathon</span>
            <span style="color: color-mix(in oklab, var(--color-warm-gray) 65%, transparent);">2025</span>
          </div>
          <h3 style="margin: 0 0 12px; font-size: 24px; font-weight: 600; color: var(--color-warm-gray);">WindWhisper</h3>
          <p style="color: var(--color-warm-gray); margin: 0 0 12px; font-size: 18px; line-height: 1.6;">
            NASA Space Apps 2025 — global nominee and local 1st place. AI-powered wind prediction and visualization platform combining computer vision, backend data pipelines, and real-time inference.
          </p>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>