---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = posts.slice(0, 3);
---

<BaseLayout title="Matheus Theodoro">
  <div class="master-grid">
    <main class="col-span-12 md:col-span-10 md:col-start-2 page-main">
      <section style="margin-bottom: var(--ma-5);">
        <h1 class="page-title">Testing AI agents where they break.</h1>
        <p style="color: var(--color-warm-gray); max-width: 90%; font-size: 20px; line-height: 1.7;">
          I'm Matheus, an AI security engineer and founder of
          <a href="/about" class="inline-link">Avenza Security</a>, building
          <a href="https://github.com/matheusht/redthread" target="_blank" rel="noopener noreferrer" class="inline-link">RedThread</a>
          —an autonomous AI red-teaming and defense-evidence engine for LLM and agentic systems.
        </p>
      </section>

      <section style="margin-bottom: var(--ma-5);">
        <h2 class="section-title">Writing</h2>
        <p style="color: var(--color-warm-gray); margin-bottom: var(--ma-1); font-size: 18px; line-height: 1.7;">
          Writing about AI security, red teaming, agentic systems, and building with LLMs:
        </p>
        <ul style="color: var(--color-warm-gray); margin: 0 0 var(--ma-2) 0; padding-left: 24px; font-size: 18px; line-height: 1.8; list-style-type: disc;">
          {
            latest.map((post) => (
              <li style="margin-bottom: 12px; padding-left: 8px;">
                <a href={`/blog/${post.slug}`} style="color: var(--color-ultramarine); text-decoration: none; transition: color 0.2s;">
                  {post.data.title}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="blog-link" href="/blog">Read the blog →</a>
      </section>

      <section style="margin-bottom: var(--ma-5);">
        <h2 class="section-title">Connect</h2>
        <div class="flex gap-[var(--ma-2)] social-links">
          <a href="mailto:dev.matheustheodoro@gmail.com" class="social-link">Email</a>
          <a href="https://github.com/matheusht" class="social-link" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="https://linkedin.com/in/matheusht" class="social-link" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>