---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  markdownHref?: string;
}

const { title, description = "Making things. Breaking things. Mostly with AI now.", markdownHref } = Astro.props;

const path = Astro.url?.pathname?.replace(/\/+$/, "") || "/";
const mdHref = markdownHref ?? (path === "/" ? "/index.md" : `${path}.md`);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://matheus.theodoro.dev/#person",
      "name": "Matheus Theodoro",
      "description":
        "AI Security Engineer and founder of Avenza Security. Builds and breaks AI systems: LLM red teaming, agentic security, and secure cloud engineering.",
      "url": "https://matheus.theodoro.dev/",
      "email": "mailto:dev.matheustheodoro@gmail.com",
      "jobTitle": "AI Security Engineer",
      "nationality": { "@type": "Country", "name": "Brazil" },
      "knowsAbout": [
        "LLM red teaming",
        "Agentic security",
        "Prompt injection",
        "MCP tool poisoning",
        "DevSecOps",
        "Cloud security",
      ],
      "worksFor": { "@id": "https://matheus.theodoro.dev/#organization" },
      "sameAs": ["https://github.com/matheusht", "https://linkedin.com/in/matheusht"],
    },
    {
      "@type": "Organization",
      "@id": "https://matheus.theodoro.dev/#organization",
      "name": "Avenza Security",
      "description":
        "AI-powered penetration testing and offensive security practice focused on AI red teaming, vulnerability management, and risk reduction.",
      "founder": { "@id": "https://matheus.theodoro.dev/#person" },
      "email": "dev.matheustheodoro@gmail.com",
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "contactType": "business inquiries",
          "email": "dev.matheustheodoro@gmail.com",
          "availableLanguage": ["en", "pt-BR"],
        },
      ],
      "address": { "@type": "PostalAddress", "addressCountry": "BR" },
    },
    {
      "@type": "WebSite",
      "@id": "https://matheus.theodoro.dev/#website",
      "url": "https://matheus.theodoro.dev/",
      "name": "Matheus Theodoro",
      "description": "Writing on AI security, LLM red teaming, and agentic systems.",
      "inLanguage": "en",
      "publisher": { "@id": "https://matheus.theodoro.dev/#person" },
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="text/markdown" href={mdHref} />
    <link rel="describedby" href="/llms.txt" />
    <link rel="icon" href="/favicon.ico" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header class="blog-header">
      <div class="container">
        <div class="name-float">
          <h1>Matheus Theodoro</h1>
          <span class="underline"></span>
        </div>
        <nav>
          <a href="/">Home</a>
          <a href="/experience">Experience</a>
          <a href="/blog">Blog</a>
        </nav>
      </div>
    </header>

    <slot />
  </body>
</html>