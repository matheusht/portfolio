---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  markdownHref?: string;
  ogType?: string;
}

const { title, description = "Making things. Breaking things. Mostly with AI now.", markdownHref, ogType = "website" } = Astro.props;

const path = Astro.url?.pathname?.replace(/\/+$/, "") || "/";
const mdHref = markdownHref ?? (path === "/" ? "/index.md" : `${path}.md`);
const canonical = `https://matheus.theodoro.dev${path === "/" ? "/" : path}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://matheus.theodoro.dev/#person",
      "name": "Matheus Theodoro",
      "description":
        "AI Security Engineer. Builds and breaks AI systems: LLM red teaming, agentic security, and secure cloud engineering.",
      "url": "https://matheus.theodoro.dev/",
      "email": "mailto:dev.matheustheodoro@gmail.com",
      "jobTitle": "AI Security Engineer",
      "nationality": { "@type": "Country", "name": "Brazil" },
      "knowsAbout": [
        "LLM red teaming",
        "Agentic security",
        "Prompt injection",
        "MCP tool poisoning",
        "DevSecOps",
        "Cloud security",
      ],
      "worksFor": {
        "@type": "Organization",
        "name": "Adapta",
        "url": "https://adapta.org",
      },
      "sameAs": ["https://github.com/matheusht", "https://linkedin.com/in/matheusht"],
    },
    {
      "@type": "WebSite",
      "@id": "https://matheus.theodoro.dev/#website",
      "url": "https://matheus.theodoro.dev/",
      "name": "Matheus Theodoro",
      "description": "Writing on AI security, LLM red teaming, and agentic systems.",
      "inLanguage": "en",
      "publisher": { "@id": "https://matheus.theodoro.dev/#person" },
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="text/markdown" href={mdHref} />
    <link rel="describedby" href="/llms.txt" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://matheus.theodoro.dev/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://matheus.theodoro.dev/og.png" />
    <link rel="icon" href="/favicon.ico" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header class="blog-header">
      <div class="container">
        <div class="name-float">
          <h1>Matheus Theodoro</h1>
          <span class="underline"></span>
        </div>
        <nav>
          <a href="/">Home</a>
          <a href="/experience">Experience</a>
          <a href="/about">About</a>
          <a href="/blog">Blog</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <slot />
  </body>
</html>