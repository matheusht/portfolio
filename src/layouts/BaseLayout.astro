---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  markdownHref?: string;
}

const { title, description = "Making things. Breaking things. Mostly with AI now.", markdownHref } = Astro.props;

const path = Astro.url?.pathname?.replace(/\/+$/, "") || "/";
const mdHref = markdownHref ?? (path === "/" ? "/index.md" : `${path}.md`);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="text/markdown" href={mdHref} />
    <link rel="describedby" href="/llms.txt" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <header class="blog-header">
      <div class="container">
        <div class="name-float">
          <h1>Matheus Theodoro</h1>
          <span class="underline"></span>
        </div>
        <nav>
          <a href="/">Home</a>
          <a href="/experience">Experience</a>
          <a href="/blog">Blog</a>
        </nav>
      </div>
    </header>

    <slot />
  </body>
</html>