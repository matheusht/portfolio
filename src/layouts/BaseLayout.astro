---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  markdownHref?: string;
  ogType?: string;
}

const { title, description = "Making things. Breaking things. Mostly with AI now.", markdownHref, ogType = "website" } = Astro.props;

const path = Astro.url?.pathname?.replace(/\/+$/, "") || "/";
const mdHref = markdownHref ?? (path === "/" ? "/index.md" : `${path}.md`);
const canonical = `https://matheus.theodoro.dev${path === "/" ? "/" : path}`;

const crumbs = [{ name: "Home", path: "/" }];
if (path !== "/") {
  const label = title.split(" — ")[0].split(" | ")[0];
  crumbs.push({ name: label, path });
}
const crumbLd = {
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    item: `https://matheus.theodoro.dev${c.path === "/" ? "/" : c.path}`,
  })),
};

const serviceLd = {
  "@type": "Service",
  name: "AI security red teaming and assessment",
  description:
    "AI red-team assessments for LLM applications and agents, agentic security reviews, prompt injection and jailbreak testing with replay-validated evidence, and secure backend/cloud/DevSecOps engineering.",
  serviceType: "AI security assessment and engineering",
  provider: { "@id": "https://matheus.theodoro.dev/#person" },
  areaServed: "Worldwide",
  url: "https://matheus.theodoro.dev/contact",
};

const faqLd = {
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Who is Matheus Theodoro?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Matheus Theodoro is an AI security engineer based in Brazil, working at Adapta. He previously founded Avenza Security (2024 — 2026) and built secure cloud infrastructure at Avenza Cloud and Marketisa.",
      },
    },
    {
      "@type": "Question",
      name: "What is RedThread?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "RedThread is a CLI-first autonomous AI red-teaming and defense-evidence engine for LLM and agentic systems. It runs adversarial campaigns (PAIR, TAP, Crescendo, GS-MCTS), scores traces against OWASP LLM and MITRE ATLAS categories, and turns confirmed failures into replay-validated guardrail candidates.",
      },
    },
    {
      "@type": "Question",
      name: "What does Matheus Theodoro write about?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Practitioner writing on AI security: LLM red teaming, agentic defense systems, multi-agent attack surfaces, prompt injection, and adversarial machine learning.",
      },
    },
    {
      "@type": "Question",
      name: "How can I contact Matheus Theodoro?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Email dev.matheustheodoro@gmail.com or reach out via LinkedIn (linkedin.com/in/matheusht) or GitHub (github.com/matheusht). Contact topics include AI red-team assessments, agentic security reviews, speaking, and writing.",
      },
    },
  ],
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    crumbLd,
    serviceLd,
    faqLd,
    {
      "@type": "Person",
      "@id": "https://matheus.theodoro.dev/#person",
      "name": "Matheus Theodoro",
      "description":
        "AI Security Engineer. Builds and breaks AI systems: LLM red teaming, agentic security, and secure cloud engineering.",
      "url": "https://matheus.theodoro.dev/",
      "email": "mailto:dev.matheustheodoro@gmail.com",
      "jobTitle": "AI Security Engineer",
      "nationality": { "@type": "Country", "name": "Brazil" },
      "knowsAbout": [
        "LLM red teaming",
        "Agentic security",
        "Prompt injection",
        "MCP tool poisoning",
        "DevSecOps",
        "Cloud security",
      ],
      "worksFor": {
        "@type": "Organization",
        "name": "Adapta",
        "url": "https://adapta.org",
        "email": "parcerias@adapta.org",
        "contactPoint": [
          {
            "@type": "ContactPoint",
            "contactType": "partnerships",
            "email": "parcerias@adapta.org",
            "availableLanguage": ["pt-BR", "en"]
          }
        ],
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Avenida Engenheiro Luis Carlos Berrini, 105 - Edifício Berrini One - 32º andar - Escritório 321, Cidade Monções",
          "addressLocality": "São Paulo",
          "addressRegion": "SP",
          "postalCode": "04571-010",
          "addressCountry": "BR"
        }
      },
      "sameAs": ["https://github.com/matheusht", "https://linkedin.com/in/matheusht"],
    },
    {
      "@type": "WebSite",
      "@id": "https://matheus.theodoro.dev/#website",
      "url": "https://matheus.theodoro.dev/",
      "name": "Matheus Theodoro",
      "description": "Writing on AI security, LLM red teaming, and agentic systems.",
      "inLanguage": "en",
      "publisher": { "@id": "https://matheus.theodoro.dev/#person" },
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="text/markdown" href={mdHref} />
    <link rel="describedby" href="/llms.txt" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://matheus.theodoro.dev/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://matheus.theodoro.dev/og.png" />
    <link rel="icon" href="/favicon.ico" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header class="blog-header">
      <div class="container">
        <div class="name-float">
          <h1>Matheus Theodoro</h1>
          <span class="underline"></span>
        </div>
        <nav>
          <a href="/">Home</a>
          <a href="/experience">Experience</a>
          <a href="/blog">Blog</a>
        </nav>
      </div>
    </header>

    <slot />
  </body>
</html>